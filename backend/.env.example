# =========================================================
# TEMPLATE ENV BACKEND (SIMPLIFIED FOR DEPLOYMENT)
# =========================================================

# Port tempat server backend akan berjalan (otomatis diisi oleh PaaS seperti Heroku/Render)
PORT=5000

# Cukup sediakan SATU variabel ini untuk koneksi database PostgreSQL saat deployment
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=postgres://postgres:password@localhost:5432/petaapp

# Kunci rahasia untuk tanda tangan token JWT (bebas diubah dengan karakter acak)
JWT_SECRET=super_secret_key_adiwarno_2026

# Kredensial Supabase (Opsional - isi nanti jika sudah ingin migrasi dari local disk ke Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
